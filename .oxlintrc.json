{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-eval": "error"
  },
  "ignorePatterns": ["dist/**", "build/**", "coverage/**", "node_modules/**", "*.min.js"]
}
